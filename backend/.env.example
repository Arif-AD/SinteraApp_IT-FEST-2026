# Application Settings
APP_NAME=Sintera
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-production-domain.com
APP_KEY=base64:YOUR_APPLICATION_KEY_HERE
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sintera_db
DB_USERNAME=sintera_user
DB_PASSWORD=your_secure_password_here
DB_SOCKET=

# Redis Configuration (Optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=postmark
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sintera.id
MAIL_FROM_NAME="Sintera"

# Postmark Email Service
POSTMARK_API_KEY=your_postmark_api_key_here

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here

# AWS Configuration (For file storage, SQS, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=your-s3-bucket-name
AWS_URL=https://your-s3-url
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_ENVIRONMENT=production

# Slack Notifications (Optional)
SLACK_BOT_USER_OAUTH_TOKEN=your_slack_bot_token
SLACK_BOT_USER_DEFAULT_CHANNEL=#alerts

# Session Configuration
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Cache Configuration
CACHE_DRIVER=database
CACHE_MEMCACHED_HOST=127.0.0.1

# Queue Configuration
QUEUE_CONNECTION=database

# Broadcasting
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=null

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com,localhost:3000
SANCTUM_ENCRYPTION_KEY=your_encryption_key_here

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Security Headers (Optional)
SECURE_HEADERS_ENABLED=true
